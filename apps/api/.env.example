MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/automatizacion_publicaciones?retryWrites=true&w=majority
PORT=3003
PUBLIC_API_URL=http://localhost:3003
JWT_SECRET=cambiar_por_un_secreto_largo_aleatorio_32chars_min
JWT_EXPIRES_IN=7d

# Local: omitir. Vercel (API + Web en dominios distintos):
# CORS_ORIGIN=https://tu-front.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# === PEDIR AL CLIENTE ===
# OpenAI — pegar key AQUÍ (este archivo operativo: apps/api/.env)
# Docs: ../../OPENAI-CLIENTE.md  |  SÍ genera costo por uso
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shopify — ver SHOPIFY-CLIENTE.md (Custom App; sin costo extra de conexión)
# Dominio sin https://  →  mitienda.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API token (shpat_…) — secreto; scopes: write_products, read_products
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
