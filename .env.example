# =============================================================================
# COPIAR A: apps/api/.env
# =============================================================================

# --- LO PONES TÚ (infra) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/automatizacion_publicaciones?retryWrites=true&w=majority
# Puerto API de ESTE proyecto (evitar choque con otros MVPs)
PORT=3003
PUBLIC_API_URL=http://localhost:3003

# Secreto de sesión JWT (≥32 caracteres aleatorios). Generar tú, no pedir al cliente.
JWT_SECRET=cambiar_por_un_secreto_largo_aleatorio_32chars_min
JWT_EXPIRES_IN=7d
# Producción Vercel (API):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# CORS_ORIGIN=https://tu-front.vercel.app

# Producción Vercel (Web → apps/web):
# PUBLIC_API_URL=https://tu-api.vercel.app


# --- PEDIR AL CLIENTE (copiar estas líneas a apps/api/.env) ---
# OpenAI: OBLIGATORIO para investigación/imágenes. SÍ genera costo por uso.
# Docs: OPENAI-CLIENTE.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shopify: ver SHOPIFY-CLIENTE.md
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
